# Copy to backend/.env for local runs. Never commit real values.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Required in production. Generate: openssl rand -hex 24 (ADMIN_TOKEN) and openssl rand -hex 32 (ENCRYPTION_KEY)
ADMIN_TOKEN=
ENCRYPTION_KEY=

# Zerodha Kite Connect (optional). Set all three to enable the login flow.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=

# Frontend only (frontend/.env). Leave empty in dev to use the Vite proxy.
# VITE_API_URL=https://stockpilot-ai-backend.onrender.com
